{
  "name": "edu-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first classroom and grading manager",
  "scripts": {
    "build": "node scripts/build.cjs",
    "build:check": "node scripts/build.cjs --check",
    "dev": "npm run build && node scripts/serve.cjs",
    "test": "npm run build:check && npm run test:unit && node audit/assets-contract.cjs && node audit/data-store-contract.cjs && node audit/workflow-review.cjs",
    "test:unit": "node --test",
    "test:assets": "node audit/assets-contract.cjs",
    "test:data-contract": "node audit/data-store-contract.cjs",
    "test:integrity": "node audit/data-integrity.cjs",
    "audit": "npm test"
  },
  "engines": {
    "node": ">=22"
  }
}
